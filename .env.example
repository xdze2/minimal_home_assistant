# miniha runtime config. Loaded by miniha/config.py at import time.
# Copy to `data/.env` and edit. Variables already set in the environment win.

# InfluxDB 1.x
MINIHA_INFLUX_HOST=localhost
MINIHA_INFLUX_PORT=8086
MINIHA_INFLUX_DB=sensors2

# MQTT broker (zigbee2mqtt)
MINIHA_MQTT_HOST=localhost
MINIHA_MQTT_PORT=1883

# Webapp
MINIHA_PORT=5001

# Flask
SECRET_KEY=change-me
