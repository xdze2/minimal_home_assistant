{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "thermalnodes/assembly",
  "title": "Assembly",
  "description": "A flat stack of material layers (wall, roof, floor, window). U-value and areal thermal mass are derived from the layers — not entered directly.",
  "type": "object",
  "required": ["id", "name", "layers"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier, referenced from model edges.",
      "examples": ["wall_pierre_40cm", "roof_beton_sous_tuile", "fenetre_double"]
    },
    "name": {
      "type": "string",
      "examples": ["Mur en pierre de taille 40 cm", "Toiture béton sous tuile"]
    },
    "layers": {
      "type": "array",
      "description": "Ordered from exterior to interior.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["material_id", "thickness"],
        "additionalProperties": false,
        "properties": {
          "material_id": {
            "type": "string",
            "description": "References a material by its id."
          },
          "thickness": {
            "type": "number",
            "description": "Layer thickness [m].",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
