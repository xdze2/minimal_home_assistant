{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "thermalnodes/model",
  "title": "ThermalModel",
  "description": "A thermal RC network: room nodes, boundary nodes, resistive edges, and heat sources. Assembles to a linear ODE C·dT/dt = -L·T + B·u(t).",
  "type": "object",
  "required": ["id", "name", "nodes", "boundaries", "edges"],
  "additionalProperties": false,
  "properties": {

    "id": { "type": "string", "examples": ["chambre_1r1c"] },
    "name": { "type": "string", "examples": ["Chambre — modèle 1R1C"] },
    "notes": { "type": "string" },

    "simulation": {
      "type": "object",
      "description": "Default simulation window and timestep.",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "format": "date", "examples": ["2026-07-01"] },
        "end":   { "type": "string", "format": "date", "examples": ["2026-07-15"] },
        "dt_minutes": {
          "type": "integer",
          "description": "Output timestep in minutes.",
          "default": 15,
          "minimum": 1
        }
      }
    },

    "nodes": {
      "type": "array",
      "description": "Room air nodes — each has a thermal capacitance and an initial temperature.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "C"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Node identifier, referenced by edges and sources.",
            "examples": ["chambre_air", "salon_air", "ceiling_mass"]
          },
          "label": { "type": "string", "description": "Display label in the UI." },
          "C": {
            "description": "Thermal capacitance [J/K]. Either a fixed value or derived from an assembly.",
            "oneOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Direct value [J/K]."
              },
              {
                "type": "object",
                "description": "Derived from an assembly and area.",
                "required": ["assembly_id", "area"],
                "additionalProperties": false,
                "properties": {
                  "assembly_id": { "type": "string" },
                  "area": { "type": "number", "exclusiveMinimum": 0, "description": "Surface area [m²]." }
                }
              }
            ]
          },
          "T_initial": {
            "type": "number",
            "description": "Initial temperature [°C]. Defaults to first value of T_series if omitted.",
            "examples": [20.0]
          },
          "ui_position": {
            "type": "object",
            "description": "Canvas position for the Svelteflow editor.",
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    },

    "boundaries": {
      "type": "array",
      "description": "Fixed-temperature boundary nodes (exterior, deep soil). Not solved — they are forcing inputs.",
      "items": {
        "type": "object",
        "required": ["id", "T_source"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "examples": ["exterior", "sol_profond"]
          },
          "label": { "type": "string" },
          "T_source": {
            "description": "Temperature forcing: a timeseries signal name or a fixed value.",
            "oneOf": [
              {
                "type": "string",
                "description": "Signal name from the simulation inputs (e.g. open_meteo/temperature_2m).",
                "examples": ["open_meteo/temperature_2m"]
              },
              {
                "type": "number",
                "description": "Fixed temperature [°C] (e.g. 12.0 for deep soil).",
                "examples": [12.0]
              }
            ]
          },
          "ui_position": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    },

    "edges": {
      "type": "array",
      "description": "Thermal resistances connecting two nodes (room↔room, room↔boundary).",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "R"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "examples": ["wall_south", "roof", "floor_slab"] },
          "label": { "type": "string" },
          "from": { "type": "string", "description": "Source node id." },
          "to":   { "type": "string", "description": "Target node id." },
          "R": {
            "description": "Thermal resistance [K/W]. Either a fixed value or derived from assembly + area.",
            "oneOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Direct value [K/W]."
              },
              {
                "type": "object",
                "description": "Derived: R = (R_si + sum(e/λ) + R_se) / area",
                "required": ["assembly_id", "area"],
                "additionalProperties": false,
                "properties": {
                  "assembly_id": { "type": "string" },
                  "area": { "type": "number", "exclusiveMinimum": 0, "description": "Surface area [m²]." }
                }
              }
            ]
          }
        }
      }
    },

    "heat_sources": {
      "type": "array",
      "description": "Time-varying heat inputs into a node (solar gain, internal gains, HVAC).",
      "items": {
        "type": "object",
        "required": ["id", "node", "signal", "gain"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "examples": ["solar_window_south", "solar_roof"] },
          "label": { "type": "string" },
          "node": {
            "type": "string",
            "description": "Target node id that receives the heat input."
          },
          "signal": {
            "type": "string",
            "description": "Signal name from simulation inputs [W/m²].",
            "examples": ["open_meteo/shortwave_radiation", "poa/roof", "poa/window_south"]
          },
          "gain": {
            "type": "number",
            "description": "Effective area or gain coefficient [m²]. Heat input = gain × signal.",
            "exclusiveMinimum": 0,
            "examples": [1.2, 8.0]
          }
        }
      }
    }

  }
}
