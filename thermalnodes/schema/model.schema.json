{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "thermalnodes/model",
  "title": "ThermalRCModel",
  "description": "A lumped thermal RC network. Masses are capacitances (integrated temperatures), boundaries are fixed/prescribed temperatures, resistances connect them, sources inject heat. Assembles to C·dT/dt = -L·T + B·u(t).",
  "type": "object",
  "required": ["schema_version", "id", "name", "masses", "boundaries", "resistances"],
  "additionalProperties": false,
  "properties": {

    "schema_version": { "type": "string", "const": "0.2", "description": "Schema version — bump when making breaking changes." },
    "id":   { "type": "string", "examples": ["chambre_1r1c"] },
    "name": { "type": "string", "examples": ["Chambre — modèle 1R1C"] },
    "notes": { "type": "string" },

    "ui_hint": {
      "type": "object",
      "description": "Default simulation window shown in the UI. Not part of the RC topology — solver run parameters live separately.",
      "additionalProperties": false,
      "properties": {
        "start":      { "type": "string", "format": "date", "examples": ["2026-07-01"] },
        "end":        { "type": "string", "format": "date", "examples": ["2026-07-15"] },
        "dt_minutes": { "type": "integer", "default": 15, "minimum": 1 }
      }
    },

    "masses": {
      "type": "array",
      "description": "Lumped thermal masses — nodes whose temperature is a state variable (capacitance C).",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "C"],
        "additionalProperties": false,
        "properties": {
          "id":    { "type": "string", "examples": ["chambre", "mur_sud"] },
          "label": { "type": "string" },
          "C": {
            "description": "Thermal capacitance [J/K].",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ui_position": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    },

    "boundaries": {
      "type": "array",
      "description": "Fixed-temperature nodes — prescribed forcing inputs, not integrated. Exterior air, deep soil, etc.",
      "items": {
        "type": "object",
        "required": ["id", "T_source"],
        "additionalProperties": false,
        "properties": {
          "id":    { "type": "string", "examples": ["exterior", "sol_profond"] },
          "label": { "type": "string" },
          "T_source": {
            "description": "Temperature forcing: a named input signal or a fixed value [°C].",
            "oneOf": [
              { "type": "string", "examples": ["open_meteo/temperature_2m"] },
              { "type": "number", "examples": [12.0] }
            ]
          },
          "ui_position": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    },

    "resistances": {
      "type": "array",
      "description": "Thermal resistances connecting two nodes (mass↔mass or mass↔boundary).",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "R"],
        "additionalProperties": false,
        "properties": {
          "id":    { "type": "string", "examples": ["mur_sud", "plancher"] },
          "label": { "type": "string" },
          "from":  { "type": "string", "description": "Source node id (mass or boundary)." },
          "to":    { "type": "string", "description": "Target node id (mass or boundary)." },
          "R": {
            "description": "Thermal resistance [K/W].",
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },

    "sources": {
      "type": "array",
      "description": "Heat inputs into a mass node: Q = gain × signal(t). Signal unit and gain unit must be consistent (e.g. W/m² × m², or W × dimensionless).",
      "items": {
        "type": "object",
        "required": ["id", "node", "signal", "gain"],
        "additionalProperties": false,
        "properties": {
          "id":     { "type": "string", "examples": ["apport_fenetre_sud"] },
          "label":  { "type": "string" },
          "node":   { "type": "string", "description": "Target mass node id." },
          "signal": { "type": "string", "description": "Named input signal.", "examples": ["poa/window_south", "occupancy_W"] },
          "gain":   { "type": "number", "exclusiveMinimum": 0, "description": "Gain coefficient. Q = gain × signal.", "examples": [1.2, 8.0] }
        }
      }
    }

  }
}
